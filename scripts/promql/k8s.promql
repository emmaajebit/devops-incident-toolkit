# Incident PromQL snippets for Kubernetes + Prometheus.
# Paste into Prometheus UI, Grafana Explore, or:
#   PROM_URL=http://localhost:9090 PROM_QUERY='up==0' ./scripts/prometheus_debug.sh

# --- Control plane / API ---
# API request error ratio (kube-apiserver)
sum(rate(apiserver_request_total{code=~"5.."}[5m]))
/
sum(rate(apiserver_request_total[5m]))

# --- Node ---
1 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m]))
node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes
node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"}
kube_node_status_condition{condition!="Ready",status="true"}
kube_node_status_condition{condition="Ready",status="false"}

# --- Workload ---
kube_pod_container_status_restarts_total
increase(kube_pod_container_status_restarts_total[1h]) > 3
kube_pod_status_phase{phase!~"Running|Succeeded"}
kube_pod_container_status_waiting_reason
kube_pod_container_status_last_terminated_reason{reason="OOMKilled"}
sum(rate(container_cpu_cfs_throttled_seconds_total[5m])) by (namespace, pod)
sum(container_memory_working_set_bytes) by (namespace, pod)
  /
sum(container_spec_memory_limit_bytes) by (namespace, pod)

# --- kube-state-metrics / deploy ---
kube_deployment_status_replicas_unavailable
kube_deployment_status_replicas_ready / kube_deployment_spec_replicas
kube_hpa_status_desired_replicas
kube_horizontalpodautoscaler_status_condition

# --- Networking ---
kube_endpoint_address_not_ready
kube_service_spec_type
rate(container_network_receive_errors_total[5m])
rate(container_network_transmit_errors_total[5m])

# --- Prometheus self ---
up == 0
prometheus_tsdb_head_series
rate(prometheus_tsdb_head_samples_appended_total[5m])
prometheus_target_interval_length_seconds
prometheus_rule_group_last_duration_seconds
prometheus_rule_evaluation_failures_total
prometheus_notifications_dropped_total
ALERTS{alertstate="firing"}

# --- RED for an HTTP app (adjust label names) ---
sum(rate(http_requests_total{status=~"5.."}[5m])) by (job, service)
/
sum(rate(http_requests_total[5m])) by (job, service)

histogram_quantile(0.99, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))
)
